<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.storemanagement.mapper.OtherInMapper">

    <insert id="insert">
        insert into is_entry(supplier,frame,time,number,type,total,cost,people,logistics,file,data,examine,cse,`check`,`user`)
        values(#{supplier},#{frame},UNIX_TIMESTAMP(#{time}),#{number},#{type},#{total},#{cost},#{people},#{logistics},#{file},#{data},#{examine},#{cse},#{check},#{user})
    </insert>

    <update id="update">
        update is_entry set supplier=#{supplier},frame=#{frame},time=UNIX_TIMESTAMP(#{time}),number=#{number},
        type=#{type},total=#{total},cost=#{cost},people=#{people},logistics=#{logistics},file=#{file},
        data=#{data},examine=#{examine},cse=#{cse},`check`=#{check},user=#{user}
        where id=#{id}
    </update>
    <update id="updateExamine">
        update is_entry set examine=#{status} where id in
        <foreach item="item" collection="ids" separator="," open="(" close=")">
            #{item}
        </foreach>
    </update>
    <update id="updateCheck">
        update is_entry set `check`=#{status} where id in
        <foreach item="item" collection="ids" separator="," open="(" close=")">
            #{item}
        </foreach>
    </update>
    <select id="getExamineByIds" resultType="java.lang.Integer">
        select examine from is_entry where id in
        <foreach item="item" collection="ids" separator="," open="(" close=")">
            #{item}
        </foreach>
    </select>
    <select id="getCheckByIds" resultType="java.lang.Integer">
        select `check` from is_entry where id in
        <foreach item="item" collection="ids" separator="," open="(" close=")">
            #{item}
        </foreach>
    </select>
    <select id="getByIds" resultType="com.zeroone.star.storemanagement.entity.EntryDO">
        select id, supplier, frame, FROM_UNIXTIME(time/1000) as time, number, type, total, cost, people, logistics, file, data, examine, cse, `check`, user
        from is_entry where id in
        <foreach item="item" collection="ids" separator="," open="(" close=")">
            #{item}
        </foreach>
    </select>

    <select id="selectById" resultType="com.zeroone.star.storemanagement.entity.EntryDO">
        select id, supplier, frame, FROM_UNIXTIME(time/1000) as time, number, type, total, cost, people, logistics, file, data, examine, cse, `check`, `user`
        from is_entry where id = #{id}
    </select>

    <select id="selectBatchIds" resultType="com.zeroone.star.storemanagement.entity.EntryDO">
        select id, supplier, frame, FROM_UNIXTIME(time/1000) as time, number, type, total, cost, people, logistics, file, data, examine, cse, `check`, `user`
        from is_entry where id in
        <foreach item="item" collection="ids" separator="," open="(" close=")">
            #{item}
        </foreach>
    </select>


</mapper>
