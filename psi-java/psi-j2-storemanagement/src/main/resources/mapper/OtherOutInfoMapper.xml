<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.storemanagement.mapper.OtherOutInfoMapper">

<select id="selectByMainIds" resultType="com.zeroone.star.storemanagement.entity.ExtryInfoDO">
    SELECT * FROM entry_info WHERE id IN
    <foreach collection="mainIds" item="id" open="(" separator="," close=")">
        #{id}
    </foreach>
</select>
</mapper>